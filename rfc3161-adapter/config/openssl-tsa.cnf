[tsa]
default_tsa = tsa_config1

[tsa_config1]
serial = private-test-keys/tsa-serial
crypto_device = builtin
signer_cert = artifacts/tsa-cert.pem
certs = artifacts/tsa-root.pem
signer_key = private-test-keys/tsa-key.pem
signer_digest = sha256
default_policy = 1.3.6.1.4.1.55555.1.3.3
other_policies = 1.3.6.1.4.1.55555.1.3.3.1
digests = sha256
accuracy = secs:1
ordering = yes
tsa_name = yes
ess_cert_id_chain = yes
ess_cert_id_alg = sha256

